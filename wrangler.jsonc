/**
 * Cloudflare Workers 配置（Rust + WebAssembly 版 Bark 推送服务端）。
 *
 * 部署（网页 + GitHub）：
 *   1. Workers & Pages -> Create -> Workers -> Connect to Git，选中本仓库。
 *   2. Build command:  bun run build
 *      Deploy command: bunx wrangler deploy
 *   3. Variables and Secrets 添加：
 *        BUN_VERSION      = 1.4.3
 *        DEVICE_KEY       = <自用密钥>（建议 Secret）
 *        APNS_PRIVATE_KEY = <可选，PEM>（建议 Secret）
 *   4. 首次部署时 wrangler 会自动创建 KV 命名空间并绑定为 `bark`
 *      （无需手动建、无需填 id；创建后会把 id 写回本文件）。
 *   5. 部署完成后调一次 /register 写入 Device Token。
 */
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bark-worker",
  "main": "build/worker/shim.mjs",
  "compatibility_date": "2025-03-01",

  "build": {
    "command": "bun run build"
  },

  // KV 绑定：Device Token 的唯一持久层。
  // 省略 id 时，wrangler 首次部署会自动创建命名空间（名为 bark-worker-bark）
  // 并写回 id；后续部署直接复用，无需手工维护。
  "kv_namespaces": [
    {
      "binding": "bark"
    }
  ],

  "vars": {
    // "DEVICE_KEY": "please-change-me-to-a-long-random-string"
  }
}
