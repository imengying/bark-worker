/**
 * Cloudflare Workers 配置（Rust + WebAssembly 版 Bark 推送服务端）。
 *
 * 部署（网页 + GitHub）：
 *   1. Workers & Pages -> Create -> Workers -> Connect to Git，选中本仓库。
 *   2. Build command:  bun run build
 *      Deploy command: bunx wrangler deploy
 *   3. 变量分两处，别放错：
 *      a) Settings -> Build -> Build variables and secrets
 *         BUN_VERSION = 1.4.3      （仅构建期可见，不进运行时）
 *      b) Settings -> Variables and Secrets（运行时，必须选 Secret）
 *         DEVICE_KEY = <自用密钥>
 *      放错的典型症状：/register 返回 "binding `DEVICE_KEY` is absent"。
 *   4. 首次部署会自动创建 KV 命名空间并绑定为 `bark`（无需填 id）。
 *   5. 部署后调一次 /register 写入 Device Token。
 */
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bark-worker",
  "main": "build/worker/shim.mjs",
  "compatibility_date": "2026-10-01",

  // 本地 `wrangler dev/deploy` 需要它来产出 build/worker/shim.mjs。
  // 脚本幂等：已构建且源文件未变时直接复用，所以即使 Dashboard 也配了
  // Build command（会先跑一次），第二次调用几乎零成本。
  "build": {
    "command": "bun run build"
  },

  // Device Token 的唯一持久层。只声明绑定名，不写 id：
  // wrangler 部署时自动创建/复用命名空间（标题为 bark-worker-bark，
  // 由 {worker 名}-{binding 名} 机械拼出，配置层面无法改）。
  "kv_namespaces": [
    {
      "binding": "bark"
    }
  ],

  // 自定义域名（如 bark.wvkr.de）在 Dashboard 手动绑定，此处不声明。
  // wrangler 在 routes 为空时不会调用 domains 接口，已绑定的域名不受部署影响。
  // 部署时若提示 local/remote 配置不一致，属预期，可忽略。
  // 若改为在此声明 routes，则每次部署会以该列表为准对齐（未声明的域名会被移除）。

  // 同时保留 workers.dev 子域，便于对照排查。
  "workers_dev": true,
  "preview_urls": false,

  "vars": {
    // "DEVICE_KEY": "please-change-me-to-a-long-random-string"
  }
}
