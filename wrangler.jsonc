/**
 * Cloudflare Workers 配置（Rust + WebAssembly 版 Bark 推送服务端）。
 *
 * 部署（网页 + GitHub）：
 *   1. Workers & Pages -> Create -> Workers -> Connect to Git，选中本仓库。
 *   2. Build command:  bun run build
 *      Deploy command: bunx wrangler deploy
 *   3. Variables and Secrets 添加：
 *        BUN_VERSION = 1.4.3
 *        DEVICE_KEY  = <自用密钥>（建议用 Secret 类型）
 *   4. 首次部署会自动创建 KV 命名空间并绑定为 `bark`（无需填 id）。
 *   5. 部署后调一次 /register 写入 Device Token。
 */
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bark-worker",
  "main": "build/worker/shim.mjs",
  "compatibility_date": "2025-03-01",

  // 本地 `wrangler dev/deploy` 需要它来产出 build/worker/shim.mjs。
  // 脚本幂等：已构建且源文件未变时直接复用，所以即使 Dashboard 也配了
  // Build command（会先跑一次），第二次调用几乎零成本。
  "build": {
    "command": "bun run build"
  },

  // Device Token 的唯一持久层。
  // id 由首次部署自动创建（命名空间名 bark-worker-bark）后写回此处；
  // 若你 fork 本仓库，删掉 id 即可让 wrangler 重新自动创建。
  "kv_namespaces": [
    {
      "binding": "bark",
      "id": "26982b88ecda4bd7aaa0ef38c172f7da"
    }
  ],

  // workers.dev 子域访问；预览 URL 用不到，显式关闭以消除部署告警。
  "workers_dev": true,
  "preview_urls": false,

  "vars": {
    // "DEVICE_KEY": "please-change-me-to-a-long-random-string"
  }
}
